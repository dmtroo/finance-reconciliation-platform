finance_reconciliation:

  target: dev

  outputs:

    dev:
      type: postgres

      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"

      user: "{{ env_var('POSTGRES_USER', 'finance') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'finance_local_only') }}"

      dbname: "{{ env_var('POSTGRES_DB', 'finance_reconciliation') }}"

      schema: "{{ env_var('DBT_SCHEMA', 'analytics_dev') }}"

      threads: "{{ env_var('DBT_THREADS', '4') | int }}"

      connect_timeout: 10
      keepalives_idle: 0